{
  "name": "olliberty",
  "displayName": "Olliberty",
  "description": "Local, private AI coding assistant powered by Ollama — for VS Code, Cursor, and IntelliJ IDEA.",
  "version": "0.0.1",
  "publisher": "codesapienbe",
  "repository": {
    "type": "git",
    "url": "https://github.com/codesapienbe/ollama-cursor.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/main/extension.js",
  "activationEvents": [
    "onLanguage"
  ],
  "contributes": {
    "commands": [
      {
        "command": "olliberty.askAI",
        "title": "Olliberty: Ask AI…"
      },
      {
        "command": "olliberty.openChatWidget",
        "title": "Olliberty: Open Chat Widget",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "olliberty.openRightPanel",
        "title": "Olliberty: Open in Right Panel",
        "icon": "$(robot)"
      },
      {
        "command": "olliberty.showSecondarySidebar",
        "title": "Olliberty: Show Secondary Sidebar",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "olliberty.clearChat",
        "title": "Clear Chat",
        "icon": "$(clear-all)"
      },
      {
        "command": "olliberty.showInstallationInstructions",
        "title": "Olliberty: Show Installation Instructions",
        "icon": "$(info)"
      }
    ],
    "keybindings": [
      {
        "command": "olliberty.openChatWidget",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "editorTextFocus"
      },
      {
        "command": "olliberty.openRightPanel",
        "key": "ctrl+shift+alt+o",
        "mac": "cmd+shift+alt+o",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "olliberty-sidebar",
          "title": "Olliberty",
          "icon": "$(robot)"
        }
      ],
      "secondarysidebar": [
        {
          "id": "olliberty-right-panel",
          "title": "Olliberty",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "olliberty-sidebar": [
        {
          "type": "webview",
          "id": "olliberty.chatView",
          "name": "Chat",
          "contextualTitle": "Olliberty Chat"
        }
      ],
      "olliberty-right-panel": [
        {
          "type": "webview",
          "id": "olliberty.rightPanelView",
          "name": "Chat",
          "contextualTitle": "Olliberty Chat"
        }
      ]
    },
    "panels": {
      "default": "olliberty-right-panel"
    },
    "menus": {
      "view/title": [
        {
          "command": "olliberty.clearChat",
          "when": "view == olliberty.chatView || view == olliberty.rightPanelView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "olliberty.openRightPanel",
          "when": "view == olliberty.chatView",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Olliberty",
      "properties": {
        "olliberty.model": {
          "type": "string",
          "default": "codellama",
          "description": "Model name sent to the Ollama daemon"
        },
        "olliberty.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 1,
          "description": "Sampling temperature"
        },
        "olliberty.maxTokens": {
          "type": "number",
          "default": 2048,
          "minimum": 1,
          "maximum": 8192,
          "description": "Maximum number of tokens to generate"
        },
        "olliberty.contextLength": {
          "type": "number",
          "default": 4096,
          "minimum": 512,
          "maximum": 8192,
          "description": "Maximum context length for conversations"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src/main",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  }
}
